      "title": "Episódio: The check, please",
      "lines": [
        {
          "speaker": "Waiter",
          "en": "Hi, welcome! How many people?",
          "pt": "Oi, bem-vindos! Quantas pessoas?"
        },
        {
          "speaker": "Bia",
          "en": "A table for two, please.",
          "pt": "Uma mesa para dois, por favor."
        },
        {
          "speaker": "Waiter",
          "en": "Here is the menu. Can I get you something to drink?",
          "pt": "Aqui está o cardápio. Querem algo para beber?"
        },
        {
          "speaker": "Bia",
          "en": "Water, please.",
          "pt": "Água, por favor."
        },
        {
          "speaker": "Waiter",
          "en": "Are you ready to order?",
          "pt": "Estão prontos para pedir?"
        },
        {
          "speaker": "Bia",
          "en": "Yes. I'd like the chicken salad, please.",
          "pt": "Sim. Eu queria a salada de frango, por favor."
        },
        {
          "speaker": "Leo",
          "en": "The burger with fries, please.",
          "pt": "O hambúrguer com batata frita, por favor."
        },
        {
          "speaker": "Waiter",
          "en": "How is everything?",
          "pt": "Está tudo bem com a comida?"
        },
        {
          "speaker": "Bia",
          "en": "It's delicious, thank you!",
          "pt": "Está delicioso, obrigada!"
        },
        {
          "speaker": "Leo",
          "en": "Can we have the check, please?",
          "pt": "Pode trazer a conta, por favor?"
        },
        {
          "speaker": "Waiter",
          "en": "Sure, here you go.",
          "pt": "Claro, aqui está."
        }
      ]
    },
