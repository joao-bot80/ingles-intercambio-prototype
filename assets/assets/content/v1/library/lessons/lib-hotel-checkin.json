      "type": "dialogue",
      "title": "Episódio 12: I have a reservation",
      "lines": [
        {
          "speaker": "Receptionist",
          "en": "Good evening. Welcome to the hotel!",
          "pt": "Boa noite. Bem-vinda ao hotel!"
        },
        {
          "speaker": "Bia",
          "en": "Hi. I have a reservation. My name is Bia Souza.",
          "pt": "Oi. Eu tenho uma reserva. Meu nome é Bia Souza."
        },
        {
          "speaker": "Receptionist",
          "en": "Can I see your passport, please?",
          "pt": "Posso ver o seu passaporte, por favor?"
        },
        {
          "speaker": "Bia",
          "en": "Here you go.",
          "pt": "Aqui está."
        },
        {
          "speaker": "Receptionist",
          "en": "Thank you. You're in room four twelve.",
          "pt": "Obrigada. Você está no quarto 412."
        },
        {
          "speaker": "Bia",
          "en": "What time is breakfast?",
          "pt": "Que horas é o café da manhã?"
        },
        {
          "speaker": "Receptionist",
          "en": "Breakfast is from seven to ten.",
          "pt": "O café da manhã é das sete às dez."
        },
        {
          "speaker": "Bia",
          "en": "What's the Wi-Fi password?",
          "pt": "Qual é a senha do Wi-Fi?"
        },
        {
          "speaker": "Receptionist",
          "en": "It's on your key card.",
          "pt": "Está no seu cartão-chave."
        },
        {
          "speaker": "Bia",
          "en": "Thank you! What time is checkout?",
          "pt": "Obrigada! Que horas é o checkout?"
        },
        {
          "speaker": "Receptionist",
          "en": "Checkout is at eleven.",
          "pt": "O checkout é às onze."
        }
      ]
    },
