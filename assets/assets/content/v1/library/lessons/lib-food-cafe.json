  "exercises": [
    {
      "type": "dialogue",
      "title": "Episódio: For here or to go?",
      "lines": [
        {
          "speaker": "Barista",
          "en": "Hi! What can I get for you?",
          "pt": "Oi! O que vai ser?"
        },
        {
          "speaker": "Leo",
          "en": "Can I have a coffee, please?",
          "pt": "Pode me ver um café, por favor?"
        },
        {
          "speaker": "Barista",
          "en": "Sure. Small, medium or large?",
          "pt": "Claro. Pequeno, médio ou grande?"
        },
        {
          "speaker": "Leo",
          "en": "Medium, please.",
          "pt": "Médio, por favor."
        },
        {
          "speaker": "Barista",
          "en": "For here or to go?",
          "pt": "Para tomar aqui ou para levar?"
        },
        {
          "speaker": "Leo",
          "en": "To go, please.",
          "pt": "Para levar, por favor."
        },
        {
          "speaker": "Barista",
          "en": "Anything else?",
          "pt": "Mais alguma coisa?"
        },
        {
          "speaker": "Leo",
          "en": "Yes, a muffin, please. How much is it?",
          "pt": "Sim, um muffin, por favor. Quanto custa?"
        },
        {
          "speaker": "Barista",
          "en": "That's six fifty.",
          "pt": "Dá seis e cinquenta."
        },
        {
          "speaker": "Leo",
          "en": "Can I pay by card?",
          "pt": "Posso pagar com cartão?"
        },
        {
          "speaker": "Barista",
          "en": "Of course. Have a nice day!",
          "pt": "Claro. Tenha um bom dia!"
        }
      ]
    },
