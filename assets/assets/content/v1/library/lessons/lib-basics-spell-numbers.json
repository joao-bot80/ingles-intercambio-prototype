    {
      "type": "dialogue",
      "title": "Episódio: Can you spell that?",
      "lines": [
        {
          "speaker": "Receptionist",
          "en": "Good afternoon. Can I have your name, please?",
          "pt": "Boa tarde. Pode me dizer o seu nome, por favor?"
        },
        {
          "speaker": "Leo",
          "en": "Leo Souza.",
          "pt": "Leo Souza."
        },
        {
          "speaker": "Receptionist",
          "en": "Can you spell your last name, please?",
          "pt": "Pode soletrar o seu sobrenome, por favor?"
        },
        {
          "speaker": "Leo",
          "en": "Sure. S, O, U, Z, A.",
          "pt": "Claro. S, O, U, Z, A."
        },
        {
          "speaker": "Receptionist",
          "en": "Sorry, can you repeat that?",
          "pt": "Desculpe, pode repetir?"
        },
        {
          "speaker": "Leo",
          "en": "S, O, U, Z, A. Souza.",
          "pt": "S, O, U, Z, A. Souza."
        },
        {
          "speaker": "Receptionist",
          "en": "Thank you. And your phone number?",
          "pt": "Obrigada. E o seu número de telefone?"
        },
        {
          "speaker": "Leo",
          "en": "Five, five, one, two, three, four, six.",
          "pt": "Cinco, cinco, um, dois, três, quatro, seis."
        },
        {
          "speaker": "Receptionist",
          "en": "How many people?",
          "pt": "Para quantas pessoas?"
        },
        {
          "speaker": "Leo",
          "en": "Two people, please.",
          "pt": "Duas pessoas, por favor."
        },
        {
          "speaker": "Receptionist",
          "en": "Great. See you on Friday!",
          "pt": "Ótimo. Até sexta!"
        }
      ]
    },
