      "type": "dialogue",
      "title": "Episódio 7: Can I help you?",
      "lines": [
        {
          "speaker": "Clerk",
          "en": "Hi! Can I help you?",
          "pt": "Oi! Posso ajudar?"
        },
        {
          "speaker": "Leo",
          "en": "Yes, I'm looking for a jacket.",
          "pt": "Sim, estou procurando uma jaqueta."
        },
        {
          "speaker": "Clerk",
          "en": "What size are you?",
          "pt": "Qual é o seu tamanho?"
        },
        {
          "speaker": "Leo",
          "en": "Medium, I think.",
          "pt": "Médio, eu acho."
        },
        {
          "speaker": "Clerk",
          "en": "The fitting room is over there.",
          "pt": "O provador é ali."
        },
        {
          "speaker": "Leo",
          "en": "Do you have this in black?",
          "pt": "Vocês têm esta em preto?"
        },
        {
          "speaker": "Clerk",
          "en": "Yes, here you go.",
          "pt": "Sim, aqui está."
        },
        {
          "speaker": "Leo",
          "en": "How much is it?",
          "pt": "Quanto custa?"
        },
        {
          "speaker": "Clerk",
          "en": "It's on sale today.",
          "pt": "Está em promoção hoje."
        },
        {
          "speaker": "Leo",
          "en": "Great! I'll take it.",
          "pt": "Ótimo! Vou levar."
        },
        {
          "speaker": "Clerk",
          "en": "Cash or card?",
          "pt": "Dinheiro ou cartão?"
        },
        {
          "speaker": "Leo",
          "en": "Card, please. Can I have a bag?",
          "pt": "Cartão, por favor. Pode me dar uma sacola?"
        }
      ]
