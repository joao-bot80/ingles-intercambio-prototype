    {
      "type": "dialogue",
      "title": "Episódio 13: Which bus?",
      "lines": [
        {
          "speaker": "Bia",
          "en": "Excuse me, does this bus go to the mall?",
          "pt": "Com licença, este ônibus vai para o shopping?"
        },
        {
          "speaker": "Driver",
          "en": "No, take the number nine.",
          "pt": "Não, pegue o número nove."
        },
        {
          "speaker": "Bia",
          "en": "Where is the bus stop for the nine?",
          "pt": "Onde fica o ponto do nove?"
        },
        {
          "speaker": "Driver",
          "en": "Across the street.",
          "pt": "Do outro lado da rua."
        },
        {
          "speaker": "Bia",
          "en": "Excuse me, how do I get to the library?",
          "pt": "Com licença, como eu chego à biblioteca?"
        },
        {
          "speaker": "Passerby",
          "en": "Go straight and turn left at the light.",
          "pt": "Siga reto e vire à esquerda no semáforo."
        },
        {
          "speaker": "Bia",
          "en": "Is it far?",
          "pt": "É longe?"
        },
        {
          "speaker": "Passerby",
          "en": "No, it's a five-minute walk.",
          "pt": "Não, são cinco minutos a pé."
        },
        {
          "speaker": "Bia",
          "en": "Thank you so much!",
          "pt": "Muito obrigada!"
        }
      ]
    },
