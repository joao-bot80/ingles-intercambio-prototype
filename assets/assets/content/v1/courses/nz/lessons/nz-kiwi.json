        {
          "speaker": "Ruby",
          "en": "Kia ora, Bia! Do you want to go to the dairy?",
          "pt": "Kia ora, Bia! Quer ir ao \"dairy\"?"
        },
        {
          "speaker": "Bia",
          "en": "What's a dairy?",
          "pt": "O que é um 'dairy'?"
        },
        {
          "speaker": "Ruby",
          "en": "It's a small shop. We can get ice cream.",
          "pt": "É uma lojinha de esquina. Dá para comprar sorvete."
        },
        {
          "speaker": "Bia",
          "en": "Sounds good! Do I need shoes?",
          "pt": "Parece ótimo! Eu preciso de sapatos?"
        },
        {
          "speaker": "Ruby",
          "en": "Nah, just wear your jandals.",
          "pt": "Não, é só usar os seus \"jandals\"."
        },
        {
          "speaker": "Bia",
          "en": "Jandals?",
          "pt": "Jandals?"
        },
        {
          "speaker": "Ruby",
          "en": "Jandals are flip-flops.",
          "pt": "Jandals são chinelos de dedo."
        },
        {
          "speaker": "Mark",
          "en": "Don't forget the chilly bin!",
          "pt": "Não esqueçam a caixa térmica!"
        },
        {
          "speaker": "Bia",
          "en": "What's a chilly bin?",
          "pt": "O que é 'chilly bin'?"
        },
        {
          "speaker": "Mark",
          "en": "It keeps the drinks cold.",
          "pt": "Ela mantém as bebidas geladas."
        },
        {
          "speaker": "Bia",
          "en": "Sweet as!",
          "pt": "Beleza!"
        },
        {
          "speaker": "Ruby",
          "en": "You sound like a kiwi!",
          "pt": "Você já fala como uma kiwi!"
