          "speaker": "Leo",
          "en": "Sure! What time?",
          "pt": "Claro! Que horas?"
        },
        {
          "speaker": "Conor",
          "en": "Half two, at the pitch behind the school.",
          "pt": "Duas e meia, no campo atrás da escola."
        },
        {
          "speaker": "Leo",
          "en": "Brilliant! Thanks a million!",
          "pt": "Demais! Muito obrigado!"
        },
        {
          "speaker": "Conor",
          "en": "No bother. See you Saturday!",
          "pt": "Imagina. Até sábado!"
        }
