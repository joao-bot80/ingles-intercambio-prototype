          "speaker": "Cashier",
          "en": "Sure. What size?",
          "pt": "Claro. De que tamanho?"
        },
        {
          "speaker": "Leo",
          "en": "Medium, please.",
          "pt": "Médio, por favor."
        },
        {
          "speaker": "Jake",
          "en": "And a double-double for me.",
          "pt": "E um double-double pra mim."
        },
        {
          "speaker": "Cashier",
          "en": "Anything else?",
          "pt": "Mais alguma coisa?"
        },
