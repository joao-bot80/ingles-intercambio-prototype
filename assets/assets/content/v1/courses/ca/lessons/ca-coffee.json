          "speaker": "Leo",
          "en": "Oh, sorry!",
          "pt": "Ops, desculpa!"
        },
        {
          "speaker": "Jake",
          "en": "Ha! In Canada, everyone says sorry.",
          "pt": "Haha! No Canadá, todo mundo pede desculpa."
        }
